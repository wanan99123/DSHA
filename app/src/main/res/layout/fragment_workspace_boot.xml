<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_workspace_boot_gradient">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="28dp"
        android:paddingRight="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DSHA" android:textStyle="bold" android:textSize="30sp"
            android:textColor="#575FCC" android:letterSpacing="0.08" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="正在开启你的工作台"
            android:textSize="16sp" android:textColor="#4A4B69" />
        <ProgressBar
            android:id="@+id/boot_busy" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="34dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary" />
        <TextView
            android:id="@+id/boot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false"
            android:text="@string/ui2_launch_hint" />
        <Button
            android:id="@+id/boot_retry"
            style="@style/Widget.DSHA.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:text="@string/ui2_restart" />
        <Button
            android:id="@+id/boot_settings"
            style="@style/Widget.DSHA.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>